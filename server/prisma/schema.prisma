
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Mess {
  id           String        @id @default(cuid())
  name         String
  currency     String        @default("BDT")
  joinCode     String        @unique @default(cuid())
  createdAt    DateTime      @default(now())
  meals        MealEntry[]
  members      Member[]
  settings     MessSetting?
  transactions Transaction[]
  users        User[]
}

model User {
  id           String   @id @default(cuid())
  messId       String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  member       Member?
  mess         Mess     @relation(fields: [messId], references: [id])
}

model Member {
  id           String        @id @default(cuid())
  messId       String
  userId       String?       @unique
  name         String
  phone        String?
  joinedAt     DateTime      @default(now())
  active       Boolean       @default(true)
  meals        MealEntry[]
  mess         Mess          @relation(fields: [messId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model MealEntry {
  id        String   @id @default(cuid())
  messId    String
  memberId  String
  date      DateTime @db.Date
  type      MealType
  quantity  Decimal  @db.Decimal(8, 2)
  note      String?
  createdBy String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    Member   @relation(fields: [memberId], references: [id])
  mess      Mess     @relation(fields: [messId], references: [id])

  @@unique([memberId, date, type])
  @@index([messId, date])
}

model Transaction {
  id              String           @id @default(cuid())
  messId          String
  memberId        String?
  type            TransactionType
  category        ExpenseCategory?
  amount          Decimal          @db.Decimal(12, 2)
  description     String
  transactionDate DateTime         @db.Date
  reference       String?
  reversedAt      DateTime?
  createdBy       String
  createdAt       DateTime         @default(now())
  member          Member?          @relation(fields: [memberId], references: [id])
  mess            Mess             @relation(fields: [messId], references: [id])

  @@index([messId, transactionDate])
}

model MessSetting {
  id                  String  @id @default(cuid())
  messId              String  @unique
  mealRate            Decimal @default(0) @db.Decimal(10, 2)
  currency            String  @default("BDT")
  allowMemberMealEdit Boolean @default(true)
  mess                Mess    @relation(fields: [messId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  messId    String
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([messId, createdAt])
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum MealType {
  DAY
  NIGHT
}

enum ExpenseCategory {
  MARKET
  UTILITIES
  RENT
  OTHER
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  ADJUSTMENT
}
