
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("postgresql://neondb_owner:npg_wcCVh3tKIJ0T@ep-raspy-forest-bdym2mvd-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require")
  directUrl = env("postgresql://neondb_owner:npg_wcCVh3tKIJ0T@ep-raspy-forest-bdym2mvd.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum MealType {
  DAY
  NIGHT
}

enum ExpenseCategory {
  MARKET
  UTILITIES
  RENT
  OTHER
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  ADJUSTMENT
}

model Mess {
  id           String        @id @default(cuid())
  name         String
  currency     String        @default("BDT")
  joinCode     String        @unique @default(cuid())
  createdAt    DateTime      @default(now())
  users        User[]
  members      Member[]
  meals        MealEntry[]
  transactions Transaction[]
  settings     MessSetting?
}

model User {
  id           String   @id @default(cuid())
  messId       String
  mess         Mess     @relation(fields: [messId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  member       Member?
}

model Member {
  id           String   @id @default(cuid())
  messId       String
  mess         Mess     @relation(fields: [messId], references: [id])
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  name         String
  phone        String?
  joinedAt     DateTime @default(now())
  active       Boolean  @default(true)
  meals        MealEntry[]
  transactions Transaction[]
}

model MealEntry {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  date      DateTime @db.Date
  type      MealType
  quantity  Decimal  @db.Decimal(8, 2)
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, date, type])
  @@index([messId, date])
}

model Transaction {
  id              String            @id @default(cuid())
  messId          String
  mess            Mess              @relation(fields: [messId], references: [id])
  memberId        String?
  member          Member?           @relation(fields: [memberId], references: [id])
  type            TransactionType
  category        ExpenseCategory?
  amount          Decimal           @db.Decimal(12, 2)
  description     String
  transactionDate DateTime          @db.Date
  reference       String?
  reversedAt      DateTime?
  createdBy       String
  createdAt       DateTime          @default(now())

  @@index([messId, transactionDate])
  @@index([memberId, transactionDate])
}

model MessSetting {
  id                  String   @id @default(cuid())
  messId              String   @unique
  mess                Mess     @relation(fields: [messId], references: [id])
  mealRate            Decimal  @default(0) @db.Decimal(10, 2)
  currency            String   @default("BDT")
  allowMemberMealEdit Boolean  @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  messId    String
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([messId, createdAt])
}
